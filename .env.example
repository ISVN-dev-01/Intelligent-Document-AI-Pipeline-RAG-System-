# Start with: python scripts/setup_env.py --mode demo (or --mode google)
# Never commit your .env. Blank DATA_DIR uses ~/.document_ai, outside source code.
APP_MODE=google
DATA_DIR=
GOOGLE_API_KEY=
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/gemini-embedding-001
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.2
# mysql is primary; sqlite is available for a local demonstration and tests.
DB_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=document_ai
MYSQL_USER=document_ai
MYSQL_PASSWORD=
AUTO_CREATE_TABLES=true
# Paths below resolve inside DATA_DIR, not inside the repository.
FAISS_INDEX_PATH=data/vector_store
UPLOAD_DIR=data/uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.35
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300
MAX_EXTRACTED_CHARS=2000000
MAX_QUESTION_CHARS=2000
MAX_CONTEXT_CHARS=12000
MEMORY_TURNS=3
API_TIMEOUT_SECONDS=60
# Generate salted hashes with setup_env.py; no built-in passwords.
ADMIN_PASSWORD_HASH=
USER_PASSWORD_HASH=
# Query history is sensitive. false redacts question/answer, retaining metrics/sources.
AUDIT_STORE_TEXT=true
